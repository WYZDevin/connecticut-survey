# Copy to backend/.env for local development.
DATABASE_URL=postgresql+psycopg://survey:survey@localhost:5434/survey
SESSION_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Dev image serving: FastAPI mounts this directory at /static/images and
# IMAGE_BASE_URL defaults to http://localhost:8000/static/images.
LOCAL_IMAGE_DIR=/mnt/raid14t/projects/connecticut-survey/svi/survey_source/NewEngland_StreetView_AllRounds_LargestArea_6200

# Production: set IMAGE_BASE_URL to the blob container and leave LOCAL_IMAGE_DIR unset.
# IMAGE_BASE_URL=https://<account>.blob.core.windows.net/svi
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Only needed by scripts/ingest_pairs.py when uploading images.
# AZURE_STORAGE_CONNECTION_STRING=
